# On the inference/VPS host, outside the public website directory.
OSERAI_CHAT_GATEWAY_KEY=replace-with-at-least-32-random-characters
OSERAI_CHAT_INFERENCE_BACKEND=parallax
OSERAI_CHAT_PARALLAX_URL=http://127.0.0.1:3001
# For a local Ollama host, select inference_backend=ollama and its exact model tag.
OSERAI_CHAT_OLLAMA_URL=http://127.0.0.1:11434
OSERAI_CHAT_OLLAMA_CONTEXT_LENGTH=4096
# For Groq, select OSERAI_CHAT_INFERENCE_BACKEND=groq and set the model to qwen/qwen3.8-27b.
OSERAI_CHAT_GROQ_API_KEY=
OSERAI_CHAT_MODEL_NAME=Qwen/Qwen3-0.6B
OSERAI_CHAT_MODEL_LABEL=OserAI Chat
OSERAI_CHAT_DB_PATH=out/chat-usage.db
OSERAI_CHAT_MAX_CONCURRENT=4
OSERAI_CHAT_REQUESTS_PER_MINUTE=10
OSERAI_CHAT_REQUESTS_PER_DAY=100
